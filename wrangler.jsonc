{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imsaeedsaeedi",
  "compatibility_date": "2026-09-01",
  // Assets-only Worker: no `main`, so no Worker script runs and nothing is billed per request.
  // `out/` is the Next static export (`next build` with output: 'export').
  "assets": {
    "directory": "./out",
    // /en/contact serves out/en/contact.html
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get out/404.html (the global not-found page) with a 404 status.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Serve only on the custom domain.
  "workers_dev": false,
  "preview_urls": false
  // Custom domains are managed in the Cloudflare dashboard (Worker > Settings > Domains & Routes).
}
