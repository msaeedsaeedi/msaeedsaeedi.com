# Cloudflare Workers Static Assets headers.

# Hashed build output never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The OG image has no file extension, so Cloudflare can't infer its type.
/en/opengraph-image
  Content-Type: image/png
/ur/opengraph-image
  Content-Type: image/png

# Plain-text views for AI engines; they contain Urdu, so declare UTF-8 explicitly.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
